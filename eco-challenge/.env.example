# Copie este archivo como `.env` (desarrollo local) o defina las mismas
# variables en Cloudflare Pages > Settings > Environment variables.
#
# URL del proyecto Supabase (Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
#
# Clave PÚBLICA del proyecto: "anon public" (JWT) o "Publishable key" (sb_publishable_...).
# Es segura en el navegador porque la base de datos está protegida con RLS.
# NUNCA use aquí la clave service_role ni una "Secret key" (sb_secret_...):
# la aplicación se niega a arrancar si detecta una.
VITE_SUPABASE_ANON_KEY=
#
# (Opcional) URL pública del sitio para el QR. Si se omite, se usa el dominio actual.
VITE_PUBLIC_SITE_URL=
