{
  "name": "ssoma-eco-challenge",
  "version": "1.0.0",
  "private": true,
  "description": "Juego multijugador tipo Kahoot para capacitaciones SSOMA: segregación de residuos según NTP 900.058:2019",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sql:bundle": "node scripts/bundle-sql.mjs",
    "test": "npm run test:unit && npm run test:sql",
    "test:unit": "node --test 'tests/unit/*.test.mjs'",
    "test:sql": "node --test --test-concurrency=1 'tests/sql/*.test.mjs'",
    "test:load:db": "node tests/load/simulate-db.mjs",
    "test:load:supabase": "node tests/load/simulate-supabase.mjs",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "build:pages": "vite build --outDir ../eco --emptyOutDir"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "pg": "8.16.3",
    "playwright": "1.63.0",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=20"
  }
}
